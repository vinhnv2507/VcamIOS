#!/bin/sh

if [ "$1" = "configure" ]; then
	if command -v uicache >/dev/null 2>&1; then
		vcam_app=/Applications/VCam.app
		if command -v jbroot >/dev/null 2>&1; then
			vcam_app="$(jbroot /Applications/VCam.app)"
		elif [ -d /var/jb/Applications/VCam.app ]; then
			vcam_app=/var/jb/Applications/VCam.app
		fi
		uicache -p "$vcam_app" >/dev/null 2>&1 || uicache >/dev/null 2>&1 || true
	fi
	killall -9 mediaserverd >/dev/null 2>&1 || true
	killall -9 cameracaptured >/dev/null 2>&1 || true
	killall -9 Camera >/dev/null 2>&1 || true
fi

exit 0
